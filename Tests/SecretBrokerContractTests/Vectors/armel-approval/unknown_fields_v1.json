      "case": "task_manifest_with_unknown_top_level_field",
      "expected_validator": "task_manifest",
      "object": {
        "schema": "armel.task.manifest",
        "schema_version": 1,
        "domain": "armel.task-approval",
        "manifest_id": "amf-0000000000000001-synthetic",
        "audience": "armel-gateway.dev.synthetic",
        "issued_at": "2026-08-09T00:00:00Z",
        "expires_at": "2026-08-09T00:03:00Z",
        "nonce": "nonce-0000000000000001-synthetic",
        "action": {
          "action_id": "act-0000000000000001-synthetic",
          "kind": "task.effect.request",
          "summary": "Synthetic manifest \"v1\" for contract vectors"
        },
        "unexpected_field": "unexpected"
      },
      "reason": "an unknown top-level field must fail closed rather than being ignored",
      "canonical_json": "{\"action\":{\"action_id\":\"act-0000000000000001-synthetic\",\"kind\":\"task.effect.request\",\"summary\":\"Synthetic manifest \\\"v1\\\" for contract vectors\"},\"audience\":\"armel-gateway.dev.synthetic\",\"domain\":\"armel.task-approval\",\"expires_at\":\"2026-08-09T00:03:00Z\",\"issued_at\":\"2026-08-09T00:00:00Z\",\"manifest_id\":\"amf-0000000000000001-synthetic\",\"nonce\":\"nonce-0000000000000001-synthetic\",\"schema\":\"armel.task.manifest\",\"schema_version\":1,\"unexpected_field\":\"unexpected\"}"
